//// ----------------------------------------------------
//// -- Plataforma de Serviços DBML
//// -- Generated by Gemini
//// ----------------------------------------------------

//// --------------------
//// -- Core App
//// --------------------

Table empresa_empresa {
  id int [pk, increment]
  nome varchar(255) [not null]
  slug varchar(50) [unique, not null]
  email varchar(254) [not null]
  imo varchar(100) [not null]
  foto varchar(100)
  admin_url varchar(50) [not null, default: 'gerentes']
  admin_title varchar(100)
  admin_subtitle varchar(150)
  admin_logo varchar(100)
  admin_favicon varchar(100)
  primary_color varchar(7) [not null, default: '#0ea5e9']
  secondary_color varchar(7) [not null, default: '#64748b']
  accent_color varchar(7) [not null, default: '#f59e0b']
  sidebar_style varchar(10) [not null, default: 'dark']
  welcome_message text
  footer_text varchar(200)

  Note: 'Tabela central para representar as empresas (tenants) na plataforma.'
}

Table core_siteconfig {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int [unique]
  site_name varchar(100) [not null]
  hero_title varchar(200) [not null]
  hero_description text [not null]
  hero_button_text varchar(50) [not null]
  hero_image varchar(100)
  hero_image_url varchar(200)

  Note: 'Configurações da vitrine para cada empresa.'
}

//// --------------------
//// -- Users App
//// --------------------

Table users_user {
  id int [pk, increment]
  password varchar(128) [not null]
  last_login datetime
  is_superuser bool [not null]
  is_staff bool [not null]
  is_active bool [not null]
  date_joined datetime [not null]
  user_type varchar(50) [not null, default: 'CLIENTE']
  name varchar(255)
  email varchar(254) [unique, not null]

  Note: 'Modelo de usuário customizado do Django.'
}

Table users_funcionario {
  usuario_id int [pk]
  empresa_id int
  cargo varchar(100) [not null]
  endereco varchar(255) [not null]
  cpf varchar(14) [unique, not null]
  is_signatario bool [not null]

  Note: 'Perfil de funcionário, estende o usuário padrão.'
}

Table users_cliente {
  usuario_id int [pk]
  empresa_id int [not null]

  Note: 'Perfil de cliente, estende o usuário padrão.'
}

//// --------------------
//// -- Produto App
//// --------------------

Table produto_categoria {
  id int [pk, increment]
  empresa_id int
  categoria varchar(100) [not null]
  slug varchar(50) [not null]

  Indexes {
    (empresa_id, categoria) [unique]
    (empresa_id, slug) [unique]
  }
  Note: 'Categorias de produtos, por empresa.'
}

Table produto_produto {
  id int [pk, increment]
  empresa_id int
  importado bool [not null]
  ncm varchar(8) [not null]
  produto varchar(100) [not null]
  slug varchar(50) [not null]
  disponivel bool [not null, default: true]
  descricao text
  preco decimal(10, 2)
  estoque int [default: 0]
  estoque_minimo int [not null, default: 0]
  data date
  categoria_id int

  Indexes {
    (empresa_id, produto) [unique]
    (empresa_id, slug) [unique]
  }
  Note: 'Tabela principal de produtos.'
}

Table produto_image {
  id int [pk, increment]
  image varchar(100) [not null]
  produto_id int
  "order" int [not null]

  Note: 'Imagens associadas a um produto.'
}

Table produto_atributo {
  id int [pk, increment]
  categoria_id int [not null]
  nome varchar(50) [not null]
  slug varchar(50) [not null]

  Indexes {
    (categoria_id, nome) [unique]
    (categoria_id, slug) [unique]
  }
  Note: 'Atributos de um produto, como Cor ou Tamanho. Vinculado a uma Categoria.'
}

Table produto_valoratributo {
  id int [pk, increment]
  atributo_id int [not null]
  valor varchar(50) [not null]
  preco_adicional decimal(10, 2) [not null, default: 0]
  percentual_adicional decimal(5, 2) [not null, default: 0]

  Indexes {
    (atributo_id, valor) [unique]
  }
  Note: 'Valores possíveis para um atributo, como "Vermelho" para "Cor".'
}

Table produto_variacaoproduto {
  id int [pk, increment]
  produto_id int [not null]
  sku varchar(50) [unique]
  preco decimal(10, 2)
  estoque int [not null, default: 0]

  Note: 'Uma variação específica (SKU) de um produto.'
}

Table produto_variacaoproduto_valores {
  id int [pk, increment]
  variacaoproduto_id int [not null]
  valoratributo_id int [not null]

  Note: 'Tabela de junção para a relação Many-to-Many entre Variação e Valores de Atributo.'
}

//// --------------------
//// -- Inventario App
//// --------------------

Table inventario_inventario {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int
  nome varchar(255) [not null]
  slug varchar(255) [not null]
  is_ativo bool [not null, default: true]
  exibir_na_vitrine bool [not null, default: false]

  Indexes {
    (empresa_id, nome) [unique]
    (empresa_id, slug) [unique]
  }
  Note: 'Representa um local de estoque físico ou virtual (ex: Loja Principal, Depósito).'
}

Table inventario_inventariosaldo {
  id int [pk, increment]
  inventario_id int [not null]
  produto_id int [not null]
  quantidade int [not null, default: 0]
  atualizado_em datetime [not null]

  Indexes {
    (inventario_id, produto_id) [unique]
  }
  Note: 'Saldo de um produto específico em um inventário específico.'
}

//// --------------------
//// -- Estoque App
//// --------------------

Table estoque_estoque {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int
  funcionario_id int
  nf int
  movimento varchar(1)
  origem_saida varchar(15)
  ordem_compra_id int
  observacao text
  processado bool [not null, default: false]
  data date [not null]
  inventario_origem_id int
  inventario_destino_id int

  Note: 'Cabeçalho de uma movimentação de estoque (entrada, saída ou transferência).'
}

Table estoque_estoqueitens {
  id int [pk, increment]
  estoque_id int [not null]
  produto_id int [not null]
  variacao_id int
  quantidade int [not null]
  saldo int
  inventario_id int [not null]

  Note: 'Itens de uma movimentação de estoque.'
}

//// --------------------
//// -- Corretor & Vendas Apps
//// --------------------

Table corretor_corretor {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int
  nome varchar(255) [not null]
  email varchar(254) [not null]
  telefone varchar(20)
  user_id int [unique]
  ativo bool [not null, default: true]

  Indexes {
    (empresa_id, email) [unique]
  }
  Note: 'Representa um corretor ou vendedor.'
}

Table corretor_interessecompra {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int
  nome_cliente varchar(255) [not null]
  email_cliente varchar(254) [not null]
  telefone_cliente varchar(20) [not null]
  mensagem text
  valor_total decimal(10, 2) [not null, default: 0]
  status varchar(20) [not null, default: 'NOVO']
  corretor_id int

  Note: 'Lead ou demonstração de interesse de um cliente.'
}

Table corretor_iteminteresse {
  id int [pk, increment]
  interesse_id int [not null]
  produto_nome varchar(255) [not null]
  variacao_info varchar(255)
  quantidade int [not null, default: 1]
  preco_unitario decimal(10, 2) [not null]

  Note: 'Itens de um interesse de compra.'
}

Table vendas_ordemcompra {
  id int [pk, increment]
  created datetime [not null]
  modified datetime [not null]
  empresa_id int
  numero varchar(20) [not null]
  interesse_id int [unique, not null]
  nome_cliente varchar(255) [not null]
  email_cliente varchar(254) [not null]
  telefone_cliente varchar(20) [not null]
  valor_total decimal(10, 2) [not null, default: 0]
  status varchar(20) [not null, default: 'PENDENTE_APROVACAO']
  aprovado_por_id int
  data_aprovacao datetime
  motivo_rejeicao text
  corretor_id int
  observacoes text

  Indexes {
    (empresa_id, numero) [unique]
  }
  Note: 'Ordem de Compra formal, gerada a partir de um Interesse.'
}

Table vendas_itemordemcompra {
  id int [pk, increment]
  ordem_id int [not null]
  produto_id int
  variacao_id int
  produto_nome varchar(255) [not null]
  variacao_info varchar(255)
  quantidade int [not null, default: 1]
  preco_unitario decimal(10, 2) [not null]

  Note: 'Itens de uma Ordem de Compra.'
}

//// --------------------
//// -- Payment App
//// --------------------

Table payment_shippingaddress {
  id int [pk, increment]
  full_name varchar(300) [not null]
  email varchar(255) [not null]
  address1 varchar(300) [not null]
  address2 varchar(300) [not null]
  city varchar(255) [not null]
  state varchar(255)
  zipcode varchar(255)
  user_id int
}

Table payment_order {
  id int [pk, increment]
  empresa_id int
  full_name varchar(300) [not null]
  email varchar(255) [not null]
  shipping_address text [not null]
  amount_paid decimal(8, 2) [not null]
  date_ordered datetime [not null]
  user_id int
}

Table payment_orderitem {
  id int [pk, increment]
  order_id int
  produto_id int
  variacao_produto_id int
  quantity int [not null, default: 1]
  price decimal(8, 2) [not null]
  user_id int
}

//// --------------------
//// -- Servico App (Legacy?)
//// --------------------

Table servico_carrinho {
  id int [pk, increment]
  empresa_id int
  identificador varchar(100) [not null]
  slug varchar(50) [not null]
  data_entrada date [not null]
  aprovacao bool [not null, default: false]
  prazo_entrega int [not null]
  status varchar(50) [not null]
  data_da_aprovacao date
  local varchar(255) [not null]

  Indexes {
    (empresa_id, slug) [unique]
  }
}

Table servico_item {
  id int [pk, increment]
  carrinho_id int [not null]
}


//// ----------------------------------------------------
//// -- Relationships
//// ----------------------------------------------------

//// Core Relationships
Ref: core_siteconfig.empresa_id - empresa_empresa.id [delete: cascade]

//// User Relationships
Ref: users_funcionario.usuario_id > users_user.id [delete: cascade]
Ref: users_funcionario.empresa_id > empresa_empresa.id [delete: cascade]
Ref: users_cliente.usuario_id > users_user.id [delete: cascade]
Ref: users_cliente.empresa_id > empresa_empresa.id [delete: cascade]

//// Produto Relationships
Ref: produto_categoria.empresa_id > empresa_empresa.id [delete: cascade]
Ref: produto_produto.empresa_id > empresa_empresa.id [delete: cascade]
Ref: produto_produto.categoria_id > produto_categoria.id [delete: set null]
Ref: produto_image.produto_id > produto_produto.id [delete: cascade]
Ref: produto_atributo.categoria_id > produto_categoria.id [delete: cascade]
Ref: produto_valoratributo.atributo_id > produto_atributo.id [delete: cascade]
Ref: produto_variacaoproduto.produto_id > produto_produto.id [delete: cascade]
Ref: produto_variacaoproduto_valores.variacaoproduto_id > produto_variacaoproduto.id
Ref: produto_variacaoproduto_valores.valoratributo_id > produto_valoratributo.id

//// Inventario & Estoque Relationships
Ref: inventario_inventario.empresa_id > empresa_empresa.id [delete: cascade]
Ref: inventario_inventariosaldo.inventario_id > inventario_inventario.id [delete: cascade]
Ref: inventario_inventariosaldo.produto_id > produto_produto.id [delete: cascade]
Ref: estoque_estoque.empresa_id > empresa_empresa.id [delete: cascade]
Ref: estoque_estoque.funcionario_id > users_user.id [delete: cascade]
Ref: estoque_estoque.ordem_compra_id > vendas_ordemcompra.id [delete: protect]
Ref: estoque_estoque.inventario_origem_id > inventario_inventario.id [delete: cascade]
Ref: estoque_estoque.inventario_destino_id > inventario_inventario.id [delete: cascade]
Ref: estoque_estoqueitens.estoque_id > estoque_estoque.id [delete: cascade]
Ref: estoque_estoqueitens.produto_id > produto_produto.id [delete: cascade]
Ref: estoque_estoqueitens.variacao_id > produto_variacaoproduto.id [delete: cascade]
Ref: estoque_estoqueitens.inventario_id > inventario_inventario.id [delete: cascade]

//// Corretor & Vendas Relationships
Ref: corretor_corretor.empresa_id > empresa_empresa.id [delete: cascade]
Ref: corretor_corretor.user_id - users_user.id [delete: set null]
Ref: corretor_interessecompra.empresa_id > empresa_empresa.id [delete: cascade]
Ref: corretor_interessecompra.corretor_id > corretor_corretor.id [delete: set null]
Ref: corretor_iteminteresse.interesse_id > corretor_interessecompra.id [delete: cascade]
Ref: vendas_ordemcompra.empresa_id > empresa_empresa.id [delete: cascade]
Ref: vendas_ordemcompra.interesse_id - corretor_interessecompra.id [delete: protect]
Ref: vendas_ordemcompra.aprovado_por_id > users_user.id [delete: set null]
Ref: vendas_ordemcompra.corretor_id > corretor_corretor.id [delete: set null]
Ref: vendas_itemordemcompra.ordem_id > vendas_ordemcompra.id [delete: cascade]
Ref: vendas_itemordemcompra.produto_id > produto_produto.id [delete: protect]
Ref: vendas_itemordemcompra.variacao_id > produto_variacaoproduto.id [delete: protect]

//// Payment Relationships
Ref: payment_shippingaddress.user_id > users_user.id [delete: cascade]
Ref: payment_order.empresa_id > empresa_empresa.id [delete: cascade]
Ref: payment_order.user_id > users_user.id [delete: cascade]
Ref: payment_orderitem.order_id > payment_order.id [delete: cascade]
Ref: payment_orderitem.produto_id > produto_produto.id [delete: cascade]
Ref: payment_orderitem.variacao_produto_id > produto_variacaoproduto.id [delete: cascade]
Ref: payment_orderitem.user_id > users_user.id [delete: cascade]

//// Servico Relationships
Ref: servico_carrinho.empresa_id > empresa_empresa.id [delete: cascade]
Ref: servico_item.carrinho_id > servico_carrinho.id [delete: cascade]